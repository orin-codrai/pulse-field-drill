# Pulse Field Drill — Caddy config
#
# PUBLIC_DOMAIN не задан  → слушаем :80 (HTTP-only, для локалки)
# PUBLIC_DOMAIN задан     → автоматический HTTPS через ACME

{$PUBLIC_DOMAIN} {
	encode gzip zstd
	root * /srv

	# Backend на docker network. ВАЖНО: handle до SPA-fallback.
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Hashed assets — строгий file_server, БЕЗ SPA-fallback.
	# Иначе запрос на устаревший /assets/index-XXXXX.js возвращает
	# index.html (200) → Telegram-WebView парсит HTML как JS → тихо падает,
	# Mini App висит на splash.
	# Имя содержит content-hash → кешируем навсегда (immutable).
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# SPA routes: для всего остального — статика по пути, иначе index.html.
	# index.html — no-cache (всегда ревалидировать через ETag): без этого
	# Caddy не шлёт Cache-Control, клиент эвристически кеширует index.html по
	# Last-Modified и держит старый JS-хеш — новый деплой до него не доезжает.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
