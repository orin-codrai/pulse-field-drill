# Pulse Field Drill — Caddy config
#
# PUBLIC_DOMAIN не задан  → слушаем :80 (HTTP-only, для локалки)
# PUBLIC_DOMAIN задан     → автоматический HTTPS через ACME

{$PUBLIC_DOMAIN} {
	encode gzip zstd
	root * /srv

	# Backend на docker network. ВАЖНО: handle до SPA-fallback.
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Hashed assets — строгий file_server, БЕЗ SPA-fallback.
	# Иначе запрос на устаревший /assets/index-XXXXX.js возвращает
	# index.html (200) → Telegram-WebView парсит HTML как JS → тихо падает,
	# Mini App висит на splash.
	handle /assets/* {
		file_server
	}

	# SPA routes: для всего остального — статика по пути, иначе index.html.
	handle {
		try_files {path} /index.html
		file_server
	}
}
