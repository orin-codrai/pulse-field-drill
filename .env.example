# Pulse — пример .env. Скопируй в .env и заполни.
# Реальный .env в репо НЕ коммитится (см. .gitignore).

# ─── Telegram ──────────────────────────────────────────────────────────────
# Получить у @BotFather: /newbot
TELEGRAM_BOT_TOKEN=

# ─── Postgres (Sprint 3) ───────────────────────────────────────────────────
POSTGRES_USER=pulse
POSTGRES_PASSWORD=
POSTGRES_DB=pulse
# Для бэкенда внутри docker compose:
DATABASE_URL=postgresql+asyncpg://pulse:${POSTGRES_PASSWORD}@db:5432/pulse

# ─── Публичный URL (Sprint 1) ──────────────────────────────────────────────
# Используется Caddy для ACME и фронтом как base URL.
PUBLIC_DOMAIN=

# ─── Окружение ─────────────────────────────────────────────────────────────
# dev | prod
PULSE_ENV=dev
